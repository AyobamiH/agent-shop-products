{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "agent-shop",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "upload_source_maps": true,
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "routes": [
    {
      "pattern": "agents.proofandstate.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "COMMERCE_DB",
      "database_name": "agent-shop-commerce",
      "database_id": "f3fa2e0b-bb41-4c51-8b44-25f699baa39b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRIVATE_KITS",
      "bucket_name": "agent-shop-private-kits",
      "jurisdiction": "eu"
    }
  ],
  "ratelimits": [
    {
      "name": "COMMERCE_RATE_LIMITER",
      "namespace_id": "1034302681",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}
