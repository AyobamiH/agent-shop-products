{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "agent-shop",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "upload_source_maps": true,
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "COMMERCE_ENABLED": "true",
    "COMMERCE_MODE": "live",
    "COMMERCE_LIVE_APPROVED": "yes:agent-shop-kit-live-20261016-v1",
    "COMMERCE_OFFER_APPROVAL": "{\"offerId\":\"private-production-agent-operating-kit\",\"version\":\"2026.10.1\",\"stripeProductId\":\"prod_agent_shop_private_kit_v2026101\",\"priceId\":\"price_1UR7AHGbPfXt7ec5XoUHlW85\",\"unitAmountPence\":900,\"currency\":\"gbp\",\"paymentModel\":\"managed_payments\",\"taxCode\":\"txcd_10202003\",\"termsVersion\":\"2026-10-16.1\",\"licenceVersion\":\"2026-10-16.1\",\"refundPolicyVersion\":\"2026-10-16.1\",\"commercialDecisionId\":\"agent-shop-kit-live-20261016-v1\",\"termsUrl\":\"https://agents.proofandstate.com/legal/kit-terms\",\"licenceUrl\":\"https://agents.proofandstate.com/legal/kit-licence\",\"refundUrl\":\"https://agents.proofandstate.com/legal/kit-refunds\"}"
  },
  "routes": [
    {
      "pattern": "agents.proofandstate.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "COMMERCE_DB",
      "database_name": "agent-shop-commerce",
      "database_id": "f3fa2e0b-bb41-4c51-8b44-25f699baa39b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRIVATE_KITS",
      "bucket_name": "agent-shop-private-kits",
      "jurisdiction": "eu"
    }
  ],
  "ratelimits": [
    {
      "name": "COMMERCE_RATE_LIMITER",
      "namespace_id": "1034302681",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}